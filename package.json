{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "bash scripts/dev.sh",
    "gen:pepper": "bash scripts/gen-auth-pepper.sh --set-env",
    "admin:check": "bash scripts/admin-check.sh",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:absence": "vitest run src/features/absences src/components/absences/__tests__ src/pages/__tests__/AbsenceForm",
    "test:coverage": "vitest run src/features/absences src/components/absences/__tests__ src/pages/__tests__/AbsenceForm --coverage",
    "test:e2e": "playwright test",
    "test:e2e:absence": "playwright test e2e/absence-form.spec.ts e2e/absence-form-accessibility.spec.ts",
    "test:watch": "vitest",
    "migrate:validate": "bash scripts/validate-migrations.sh",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.16.0",
    "luxon": "^3.7.2",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.15.1",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "^4.1.7",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^4.1.7"
  }
}
